<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>osu.Game.Rulesets.Sayobot</AssemblyName>
    <RootNamespace>osu.Game.Rulesets.Sayobot</RootNamespace>
    <Version>0.1.0</Version>
    <PpyOsuGameVersion Condition="'$(PpyOsuGameVersion)' == ''">2026.916.0</PpyOsuGameVersion>
    <LazerReferenceDirectory Condition="'$(LazerReferenceDirectory)' == ''">$(MSBuildThisFileDirectory)../.tools/lazer-2026.1005.0/usr/bin</LazerReferenceDirectory>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup Condition="!Exists('$(LazerReferenceDirectory)/osu.Game.dll')">
    <PackageReference Include="ppy.osu.Game" Version="$(PpyOsuGameVersion)" />
  </ItemGroup>
  <ItemGroup Condition="Exists('$(LazerReferenceDirectory)/osu.Game.dll')">
    <Reference Include="$(LazerReferenceDirectory)/*.dll"
               Exclude="$(LazerReferenceDirectory)/System.*.dll;$(LazerReferenceDirectory)/Microsoft.*.dll;$(LazerReferenceDirectory)/netstandard.dll;$(LazerReferenceDirectory)/mscorlib.dll;$(LazerReferenceDirectory)/WindowsBase.dll">
      <Private>false</Private>
    </Reference>
    <PackageReference Include="ppy.osu.Framework.SourceGeneration" Version="2025.1121.1" PrivateAssets="all" />
  </ItemGroup>
</Project>
